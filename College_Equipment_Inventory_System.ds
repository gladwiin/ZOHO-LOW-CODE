 application "College Equipment Inventory System"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form approval_log
		{
			displayname = "Approval Log"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			log_id
			(
    			type = text
				displayname = "Log ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			borrow_request
			(
				type = list	
				displayname = "Borrow Request"
				values  = borrow_request.ID
    			displayformat = [request_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			approver
			(
				type = list	
				displayname = "Approver"
				values  = staff_registration.ID
    			displayformat = [staff_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			decision
			(
				type = radiobuttons
				displayname = "Decision"
				values = {"Approved","Rejected"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			decision_date
			(
    			type = datetime
				displayname = "Decision Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			comments
			(
    			type = textarea
				displayname = "Comments"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form borrow_request
		{
			displayname = "Borrow Request"
			success message = "Borrow Request Added Successfully"
