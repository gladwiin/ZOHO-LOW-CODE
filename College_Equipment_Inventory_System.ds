	reports
	{
		list equipment_issue_register_Report
		{
			displayName = "All Equipment Issue Registers"
			show all rows from equipment_issue_register    
			(
				issue_id as "Issue ID"
				borrow_request as "Borrow Request"
				equipment as "Equipment"
				student_id as "Student ID"
				issued_quantity as "Issued Quantity"
				issue_date as "Issue Date"
				issued_by as "Issued By"
				issue_condition as "Issue Condition"
				issue_status as "Issue Status"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (issue_condition == "Fair")
				fields = [issue_condition]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (issue_condition == "Good")
				fields = [issue_condition]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (issue_condition == "Needs Repair")
				fields = [issue_condition]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
