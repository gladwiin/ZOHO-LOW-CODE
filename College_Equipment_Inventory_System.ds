		workflow
		{
		form
		{
			auto_set_borrow_status as "Auto-Set Borrow Request Status"
			{
				type =  form
				form = borrow_request

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Set the request_status field to Pending when the form loads
										input.request_status = "Pending";
						)
					}
				}

			}
			notify_student_approval as "Notify Student on Approval"
			{
				type =  form
				form = borrow_request

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the student record using the lookup field from input
										studentRecord = student_registration[ID == input.student];
										// Check if student email is available
										if(studentRecord.email.isNull())
										{
											info "Student email is not available";
										}
										else
										{
											// Fetch the equipment details for the request
											equipmentList = equipment[ID in input.equipment];
											// Build equipment names string
											equipmentNames = "";
											for each  equipment in equipmentList
											{
												if(equipmentNames.isEmpty())
												{
													equipmentNames = input.equipment.equipment_name;
												}
												else
												{
													equipmentNames = equipmentNames.concat(", ").concat(input.equipment.equipment_name);
												}
											}
											// Send email to student
											sendmail
											[
												from :zoho.loginuserid
												to :studentRecord.email
												subject :"Your Borrow Request Has Been Approved"
												message :"Dear " + studentRecord.student_name.first_name + ",\n\nYour borrow request for the following equipment has been approved:\n\n" + equipmentNames + "\n\nPlease collect the equipment from the inventory office.\n\nBest regards,\nEquipment Management Team"
											]
										}
						)
					}
				}

			}
		}

		schedule
		{
			overdue_return_reminder as "Overdue Return Reminder"
			{
				type =  schedule
				form = borrow_request
					status = inactive
				start = expected_return_date at "10:00:00"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Fetch borrow requests where expected return date is in the past and status is not Returned
										overdueRequests = borrow_request[expected_return_date < zoho.currentdate && request_status != "Returned"];
										// Check if there are any overdue requests
										if(overdueRequests.count() > 0)
										{
											// Iterate through each overdue request
											for each  request in overdueRequests
											{
												// Get student details from the lookup
												studentRecord = student_registration[ID == request.student];
												// Validate student email exists
												if(studentRecord.email.isNull())
												{
													continue;
												}
												// Get equipment details
												equipmentList = equipment[ID in request.equipment.getall()];
												equipmentNames = "";
												// Build equipment names list
												for each  eq in equipmentList
												{
													if(isBlank(equipmentNames))
													{
														equipmentNames = eq.equipment_name;
													}
													else
													{
														equipmentNames = equipmentNames.concat(", ").concat(eq.equipment_name);
													}
												}
												// Get student name
												studentName = studentRecord.student_name.first_name.concat(" ").concat(studentRecord.student_name.last_name);
												// Send reminder email
												sendmail
												[
													from :zoho.loginuserid
													to :studentRecord.email
													subject :"Reminder: Equipment Return Due"
													message :"Dear " + studentName + ",\n\nThis is a reminder that the following equipment is due for return:\n\n" + equipmentNames + "\n\nExpected Return Date: " + request.expected_return_date.getDateTime() + "\n\nPlease return the equipment as soon as possible.\n\nThank you."
												]
											}
										}
					)
					}
				}
			}
		}




	}
